# 依赖
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
env/

# 构建产物
# 注意别写 build/ —— client/build/ 里放着安装脚本和 pyinstaller 配置，那是源码
dist/
teacher/dist/
server/public/dist/
*.egg-info/

# 数据库与运行时数据
*.db
*.db-journal
*.sqlite
*.sqlite3
# 只忽略服务端的运行时目录。
# 千万别写成光秃秃的 data/ —— 那条会匹配任何层级下叫 data 的目录，
# 把 teacher/src/data/quotes.json 一起吃掉，EdgeOne 上构建就 ENOENT 了。
/server/data/

# 配置与密钥（只提交 *.example.*）
config.json
.env
.env.local
*.json.bak

# Cloudflare Tunnel 凭证
server/cloudflared/*.json
server/cloudflared/config.yml
*.pem

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
