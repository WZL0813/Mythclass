# 复制为 .env 后填写。.env 不要提交 Git。
PORT=3000
HOST=127.0.0.1

# 两个密钥必须不同，至少 32 位随机
JWT_SECRET=change-me-teacher-secret-at-least-32-chars
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-chars

# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=https://mythclass.ryokuryuneko.top,http://localhost:5173

# 自定义数据库路径（留空则用 ./data/mythclass.db）
DB_FILE=
